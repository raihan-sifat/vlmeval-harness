# Copy to `.env` and fill in only the providers you use.
# `.env` is gitignored. The harness loads it automatically; you can also export
# these variables in your shell, which takes precedence.

# OpenAI  (gpt-4o, gpt-4.1, gpt-4o-mini, ...)
OPENAI_API_KEY=

# Anthropic  (claude-opus-4, claude-sonnet-4, claude-3-5-haiku, ...)
ANTHROPIC_API_KEY=

# Google Gemini  (gemini-2.0-flash, gemini-1.5-pro, ...)
GOOGLE_API_KEY=

# Optional: override the default base URLs (proxies, gateways, vLLM endpoints).
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=
