# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Datasets and images are reproducible, not versioned.
# `data/samples/synthetic_v1/` is the one exception: it is generated by
# `scripts/make_fixtures.py` from a fixed seed and is committed on purpose.
data/datasets/*
!data/datasets/.gitkeep
data/samples/*
!data/samples/synthetic_v1/
data/cache/*
!data/cache/.gitkeep

# Raw per-item traces: large, and reproducible from the committed fixtures.
# The per-run `results.jsonl` and every report are kept.
results/raw/
results/**/*.log
results/**/cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
